AZURE_SPEECH_KEY=ここにSpeechリソースのKey 1を入力
AZURE_SPEECH_REGION=japaneast
PORT=3002

# 任意: 設定すると、ミラー音声(癖の反映)の生成にOpenAIのinstructions式TTS
# (gpt-4o-mini-tts)を優先して使う。Azureの固定スタイル+度合いより自然な
# 感情表現が期待できる。未設定の場合や呼び出し失敗時は既存のAzure経路にそのまま
# フォールバックするので、設定しなくてもアプリは通常通り動く。
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_MALE=onyx
OPENAI_TTS_VOICE_FEMALE=nova
